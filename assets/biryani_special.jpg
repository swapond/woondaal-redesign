    <script src="https://woondaal.com/custom/js/js.js?id=3.4.1"></script>
    <script src="https://woondaal.com/custom/js/cartFunctions.js?v=2.2"></script>
    <script src="https://woondaal.com/custom/js/cartSideMenu.js?v=2.6"></script>
    <script src="https://woondaal.com/custom/js/timeslot.js?v=2.0"></script>

    <script src="https://woondaal.com/vendor/intltelinput/build/js/intlTelInput.js"></script>
    <script src="https://woondaal.com/vendor/intltelinput/build/js/utils.js"></script>

    <script>
        var __shopId = '38';
        let isItemSharingEnabled = '1';
        document.querySelector("#productModal").addEventListener("scroll", function() {
            const pmodalHeadSection = document.querySelector("#pmodal-head-section");
            const scroll = document.querySelector("#productModal").scrollTop;
            console.log(scroll);

            if (scroll >= 60) {
                pmodalHeadSection.classList.add("modalHeaderBg");
            } else {
                pmodalHeadSection.classList.remove("modalHeaderBg");
            }
        });

        setTimeout(() => {
            document.getElementById("theCartBottomButton").classList.remove("d-none");
        }, 1500);


        const products = items;
        console.log("products", products);

        const searchBox = document.getElementById('search-box');
        const suggestions = document.getElementById('suggestions');

        searchBox.addEventListener('input', () => {
            const searchTerm = searchBox.value.toLowerCase();
            suggestions.innerHTML = '';

            if (searchTerm.length === 0) {
                return;
            }

            const matchingProducts = products.filter(product => product.name.toLowerCase().includes(searchTerm));

            matchingProducts.forEach(product => {
                if (product.category_active == 0) {
                    return;
                }
                const suggestion = document.createElement('div');
                suggestion.classList.add('suggestion');
                suggestion.innerHTML = product.name;
                suggestion.addEventListener('click', () => {
                    let name = product.name;
                    // convert spaces to dashes

                    name = name.replace(/\s+/g, '-').toLowerCase();
                    let id = 'iid' + name;

                    console.log("id", id);

                    document.getElementById(id).click();
                });
                suggestions.appendChild(suggestion);
            });
        });

        document.addEventListener('click', event => {
            if (!event.target.matches('.suggestion')) {
                suggestions.innerHTML = '';
            }
        });

        function showHideDesc(flag) {
            if (flag == 1) {
                document.getElementById('shorted').classList.remove('d-block');
                document.getElementById('shorted').classList.add('d-none');

                document.getElementById('longed').classList.remove('d-none');
                document.getElementById('longed').classList.add('d-block');
            } else {
                document.getElementById('shorted').classList.remove('d-none');
                document.getElementById('shorted').classList.add('d-block');

                document.getElementById('longed').classList.remove('d-block');
                document.getElementById('longed').classList.add('d-none');
            }
        }
    </script>

