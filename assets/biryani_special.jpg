<body>
            <div id="theCartBottomButton" onClick="openNav(); showCart();"
            class="d-none close-mobile-menu circle icon icon-shape bg-gradient-red text-white rounded-circle shadow mb-4"
            style=" background: linear-gradient(87deg, #ffffff 0, #ffffff 100%) !important;cursor:pointer">
            <img src="https://cdn-icons-png.flaticon.com/512/891/891407.png" width="40" alt="">
            <span id="cartButtonHolder" v-if="counter>0" class="badge badge-primary"
                style="float: right; position: absolute; right: -7px; top: 30px;">{{ counter }}</span>
        </div>
    
    <style>
    .pmodal.pleft .pmodal-dialog {
        position: fixed;
        right: 0;
        margin: auto;
        width: 430px;
        height: 100%;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }

    .pmodal.pleft .pmodal-content {
        height: 100%;
        overflow-y: auto;
    }

    .pmodal.pright .pmodal-body {
        padding: 15px 15px 80px;
    }

    .pmodal.right.pfade .pmodal-dialog {
        left: -430px;
        -webkit-transition: opacity 0.3s linear, left 0.3s ease-out;
        -moz-transition: opacity 0.3s linear, left 0.3s ease-out;
        -o-transition: opacity 0.3s linear, left 0.3s ease-out;
        transition: opacity 0.3s linear, left 0.3s ease-out;
    }

    .pmodal.pright.pfade.show .pmodal-dialog {
        right: 0;
    }

    /* ----- MODAL STYLE ----- */
    .pmodal-content {
        border-radius: 0;
        border: none;
    }

    .pmodal-header {
        border-bottom-color: #eeeeee;
        background-color: #fafafa;
    }

    .qtyInp:focus {
        outline: none;
    }

    #modalImg {
        width: 100%;
        height: auto;
        margin: 0 auto;
        min-height: 300px;
    }

    /* carousel css */

    .slider {
        /* width: 1300px;
        max-width: 100vw;
        height: 700 px; */

        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 430px;
        height: auto;
        margin: 0 auto;
        min-height: 300px;
    }

    .list {
        position: absolute;
        top: 0;
        left: 0;
        height: auto;
        display: flex;
        width: max-content;
        transition: 1s;
    }

    .list .itemImg img {
        width: 100%;
        height: 0px;
        margin: 0 auto;
        min-height: 300px;
        /* object-fit: cover; */
    }

    .buttons {
        position: absolute;
        top: 120px;
        left: 20px;
        width: 90%;
        display: flex;
        justify-content: space-between;
    }

    .buttons button {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.616);
        border: none;
        font-family: monospace;
        font-weight: bold;
        cursor: pointer;
    }

    /* .dots {
        position: absolute;
        top: 270px;
        width: 100%;
        color: #fff;
        left: 0;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;

    } */


    /* .dots li {
        list-style-type: none;
        width: 15px;
        height: 15px;
        background-color: #fff;
        border-radius: 10px;
        margin: 0 10px;
        padding: 0;
        cursor: pointer;
        transition: 1s;
    }

    .dots li.active {
        width: 35px;
        border-radius: 10px;
        background-color: #fff;
    } */

    /* ------------------------------ */

    @media (max-width: 767px) {
        .pmodal.pleft .pmodal-dialog {
            width: 100%;
        }
    }

    @media (min-width: 768px) {
        .pmodal.pleft .pmodal-dialog {
            position: fixed;
            right: 0;
            margin: auto;
            width: 430px;
            height: 100%;
            -webkit-transform: translate3d(0%, 0, 0);
            -ms-transform: translate3d(0%, 0, 0);
            -o-transform: translate3d(0%, 0, 0);
            transform: translate3d(0%, 0, 0);
        }
    }

    .head-sticky {
        position: sticky;
        top: 0;
        z-index: 9999;
        background: transparent;
    }

    .foot-sticky {
        position: sticky;
        bottom: 0;
        z-index: 9999;
        background: white;
    }

    .modalHeaderBg {
        background-color: rgb(25 25 25 / 80%);
        border-radius: 0;
    }

    .modal-footer>* {
        margin: 0rem;
    }

    .btn-black {
        background-color: #000;
        color: #fff;
    }

    .btn-black:hover {
        background-color: #000;
        color: #fff;
    }
</style>

<div class="modal fade pmodal pfade pleft" id="productModal" z-index="9999" tabindex="-1" role="dialog"
    aria-labelledby="modal-form" aria-hidden="true">
    <div class="modal-dialog modal-lg pmodal-dialog modal-" role="document" id="modalDialogItem">
        <div class="pmodal-content modal-content">
            <div class="py-2 px-3 d-flex justify-content-between head-sticky" id="pmodal-head-section">
                <button type="button" class="bg-white rounded-circle border border-10 border-dark p-1 kwikz-temp-p"
                    data-dismiss="modal" aria-label="Close">
                    <img src="/images/close.svg" width="20" alt="">
                </button>
                <button type="button" class="bg-white rounded-circle border border-10 border-dark p-1 kwikz-temp-p"
                    data-dismiss="modal" aria-label="Close" data-toggle="modal" data-target="#itemShareModal"
                    id="share-btn" item-id="">
                    <img src="/images/share.svg" width="20" alt="">
                </button>
            </div>

            <div class="modal-body pmodal-body px-3 py-0">
                <div class="">
                    <div class="text-center" id="modalImgPart" style="display:flex">
                        <img id="modalImg" src="">
                    </div>
                    <div class="font-weight-bold mt-3" id="modalTitle">

                    </div>

                    <div class="" id="modalItemDetailsPart">
                        <input id="modalID" type="hidden" />
                        <div id="modalPrice" class="new-price mt-2 font-weight-bold"></div>
