            <div id="cartSideNav" class="sidenav-cart sidenav-cart-close notranslate" style="background: white">
  <input type="hidden" id="shop_id" value="38">

  <div class="px-2 mb-2" style="display: block">
    <div class="d-flex justify-content-between align-items-center ml-2">
      <div class="mt-3">
        <p class="h4" id="cartHeading" style="display: block; font-weight: bold;">Shopping Cart</p>
        <p class="h4" id="chkoutHeading" style="display: none; font-weight: bold;">Checkout</p>
      </div>
      <div><a style="font-size:30px" class="text-black rounded-full p-2" href="javascript:void(0)"
          onclick="closeNav()">&times;</a></div>
    </div>

    <div id="modalCart" class="searchable-container">
      <div id="cartList">
        <div v-for="item in items" class="items col-xs-12 col-sm-12 col-md-12 col-lg-12 clearfix mt-3">
          <div class="d-flex nfo-block block-info" v-cloak style="column-gap: 10px">
            <div class="square-box pull-left">
              <img :src="item.attributes.image" class="productImage" width="100" height="105" alt="">
            </div>
            <div>
              <h6 class="product-item_title">{{ item.name }}</h6>
              <h6 class="product-item_quantity">{{ item.quantity }} x {{ item.attributes.friendly_price }}</h6>
              <div class="d-flex" style="column-gap: 3px;">
                <button type="button" v-on:click="decQuantity(item.id)" :value="item.id"
                  class="btn btn-outline-primary btn-icon btn-sm page-link btn-cart-radius">
                  <span class="btn-inner--icon btn-cart-icon"><i class="fa fa-minus"></i></span>
                </button>
                <button type="button" v-on:click="incQuantity(item.id)" :value="item.id"
                  class="btn btn-outline-primary btn-icon btn-sm page-link btn-cart-radius">
                  <span class="btn-inner--icon btn-cart-icon"><i class="fa fa-plus"></i></span>
                </button>
                <button type="button" v-on:click="remove(item.id)" :value="item.id"
                  class="btn btn-outline-primary btn-icon btn-sm page-link btn-cart-radius">
                  <span class="btn-inner--icon btn-cart-icon"><i class="fa fa-trash"></i></span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="totalPrices" class="mt-2 px-2" v-cloak>
        <div class="card card-stats mb-3">
          <div class="card-body">
            <div class="row">
              <div class="col luxe-cart-subtotal">
                <span v-if="itemsCount==0">Cart is empty!</span>
                <span v-if="itemsCount"><strong>Subtotal:</strong></span>
                <span v-if="itemsCount" class="ammount"><strong>{{ totalPriceFormat }}</strong></span>
              </div>
            </div>
          </div>
        </div>
        <br />
        <div v-if="itemsCount" v-cloak>
          <button class="w-100 d-flex justify-content-between btn-primary btn btn-sm py-2 luxe-chkout-btn"
            onclick="showChkout()">
            <span class="btn-inner--text">
              <i class="fa fa-shopping-bag mr-2"></i>
              Place Order
            </span>
            <span id="orderTotalValue"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <section id="modalChkout" class="section" style="display: none; padding-top: unset; background:white">
    
      <div class="container">
        

        <form id="order-form2" role="form" method="post" action="https://woondaal.com/order" autocomplete="off"
          enctype="multipart/form-data">
          <input type="hidden" name="_token" value="XurmeMR8riwoCRKuav9vEBibKFeb1I4obPZxDtGj">
                                    
              <input type="hidden" name="device" id="device">
              <input type="hidden" name="inhouse" id="inhouse" value="0">
              <input type="hidden" name="free_delivery" id="free_delivery" value="0">
              <input type="hidden" name="disable_wa_ordering" id="disable_wa_ordering"
                value="0">
              
              <!-- Delivery method -->
              <div class="d-flex px-2" style="column-gap: 20px;">

                                  <div class="custom-control custom-radio mb-3">
                    <input name="deliveryType" class="custom-control-input" id="deliveryTypeDeliver" type="radio"
                      value="delivery" checked>
                    <label class="custom-control-label" for="deliveryTypeDeliver">Delivery</label>
                  </div>
                
                                  <div class="custom-control custom-radio mb-3">
                    <input name="deliveryType" class="custom-control-input" id="deliveryTypePickup" type="radio"
                      value="pickup">
                    <label class="custom-control-label" for="deliveryTypePickup">Pickup</label>
                  </div>
                              </div>

              <!-- Client informations -->
              <div class="px-2 mt-2" id="clientBox">
                <label for="custom[client_phone]">Your phone</label>
                <input type="text" name="custom[client_phone]" class="form-control form-control custom-phone"
                  id="custom[client_phone]" placeholder="Please enter phone number" oninput="getCustomerInfo(event)"
                  pattern="[0-9]{10,}" title="Please enter a valid phone number with at least 10 digits" required>

                <div class="mt-2">
                  <label for="custom[client_name]">Your name</label>
                  <input type="text" name="custom[client_name]" class="form-control form-control"
                    id="custom[client_name]" oninput="makeNameAlpha(event)" placeholder="Please enter your name"
                    required>
                </div>
              </div>


              <!-- Delivery time slot -->
              <div class="px-2 mt-2">
  <label for="dateslot" class="delDate">Delivery date</label>
  <label for="dateslot" class="picDate">Pickup date</label>
  <input type="date" id="dateslot" class="form-control" name="delivery_date"
    onchange="changeTimeSlot(38, this.value)" value="2026-09-14" min="2026-09-14"
    placeholder="Enter Date" required>

</div>
<div class="px-2 mt-2">
  <label for="timeslot" class="delTime delTimeTS">Delivery time</label>
  <label for="timeslot" class="picTime picTimeTS">Pickup time</label>
  <div class="">
    <select name="timeslot" id="timeslot"
      class="noselecttwo form-control" required>
              <option value=810_840>1:30 PM - 2:00 PM</option>
              <option value=840_870>2:00 PM - 2:30 PM</option>
              <option value=870_900>2:30 PM - 3:00 PM</option>
              <option value=900_930>3:00 PM - 3:30 PM</option>
              <option value=930_960>3:30 PM - 4:00 PM</option>
              <option value=960_990>4:00 PM - 4:30 PM</option>
              <option value=990_1020>4:30 PM - 5:00 PM</option>
              <option value=1020_1050>5:00 PM - 5:30 PM</option>
              <option value=1050_1080>5:30 PM - 6:00 PM</option>
              <option value=1080_1110>6:00 PM - 6:30 PM</option>
              <option value=1110_1140>6:30 PM - 7:00 PM</option>
              <option value=1140_1170>7:00 PM - 7:30 PM</option>
              <option value=1170_1200>7:30 PM - 8:00 PM</option>
              <option value=1200_1230>8:00 PM - 8:30 PM</option>
              <option value=1230_1260>8:30 PM - 9:00 PM</option>
              <option value=1260_1290>9:00 PM - 9:30 PM</option>
              <option value=1290_1320>9:30 PM - 10:00 PM</option>
              <option value=1320_1350>10:00 PM - 10:30 PM</option>
              <option value=1350_1380>10:30 PM - 11:00 PM</option>
              <option value=1380_1410>11:00 PM - 11:30 PM</option>
              <option value=1410_0>11:30 PM - 12:00 AM</option>
              <option value=0_30>12:00 AM - 12:30 AM</option>
          </select>
  </div>
</div>

              <!-- Custom Fields  -->
              
              <!-- Delivery adress -->
              <div class="px-2 mt-2" id="addressBox">
  <label for="addressID">Delivery Address</label>
  <input class="form-control form-control" type="text" name="addressID" id="addressID"
    placeholder="Your delivery address here...">
      <div class="mt-2">
      <label for="delivery_area">Delivery area</label>
      <select name="delivery_area" id="delivery_area"
        class="noselecttwo form-control">
        <option value="">Select delivery area</option>
                  <option data-cost="75"
            data-min-order-cost="0"
            value="53">
            Inside Sylhet City ৳75.00
          </option>
                  <option data-cost="150"
            data-min-order-cost="0"
            value="54">
            Outside Sylhet City ৳150.00
          </option>
              </select>
      <div id="minDeliveryOrderDiv" style="display:none">
        <span>*Minimum order value</span>
        <span id="minDeliveryOrderPrice"></span>
        <span>for delivery</span>
      </div>
    </div>
  </div>

              <!-- Comment -->
              <div class="px-2 mt-2">
  <div class="form-group">
    <label for="comment">Notes</label>
    <textarea name="comment" id="comment" class="form-control"
      placeholder="Your comment here ..."></textarea>
      </div>
</div>

              <!-- Payment -->
              <div class="px-2 mb-2">
  <!-- Price overview -->
  <div id="totalPricesCheckout" v-cloak>
    <div class="mt-2">
      <span v-if="itemsCount==0">Cart is empty!</span>

      <div class="d-flex justify-content-between">
        <div class="font-weight-bold">Order Summery</div>
        <div class="d-flex align-items-center justify-content-end" onclick="showCart()" style="cursor:pointer">
          <div class="mr-1 back-to-cart">
            <i class="text-primary fa fa-reply"></i>
          </div>
          <div class="d-flex align-items-center text-primary fw-bold">
            Back to Cart
          </div>
        </div>
      </div>

      <div class="alert alert-danger mt-2" id="minDelErrAlert" style="display: none; padding: 5px 7px;">
        <span id="minDelErrMsg"></span>
        <button type="button" class="close" onclick="document.getElementById('minDelErrAlert').style.display='none'">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div v-if="itemsCount" class="d-flex justify-content-between mt-1">
        <span> Your Order Total</span>
        <span id="orderTotal" class="ammount">{{ totalPriceFormat }}</span>
      </div>

      <div id="totalOrderPrice" class="d-none">{{ totalPrice }}</div>

      <div v-if="itemsCount&&deliveryPrice>0" class="d-flex justify-content-between mt-1">
        <span>Delivery Charge</span>
        <span class="ammount">{{ deliveryPriceFormated }}</span>
      </div>

      
      <div v-if="deduct" class="d-flex justify-content-between mt-1">
        <span v-if="deduct">Applied coupon discount:</span>
        <span v-if="deduct" class="ammount">{{ deductFormat }}</span>
      </div>

      <div v-if="itemsCount" class="d-flex justify-content-between mt-1">
        <span class="font-weight-bold">Total Payable</span>
        <span id="orderTotalPay" class="ammount">{{ withDeliveryFormat }}</span>
      </div>
      <input v-if="itemsCount" type="hidden" id="tootalPricewithDeliveryRaw" :value="withDelivery" />
    </div>
  </div>
  <!-- End price overview -->
  <div class="my-2">
                </div>

  <!-- END Payment -->

  


  <div class="text-center mt-4" id="">
    <button v-if="totalPrice" type="submit"
      class="btn btn-icon btn-primary mt-2 paymentbutton w-100 d-flex justify-content-between luxe-chkout-btn"
      id="sendWhatsapp">
      <span class=""><i class="fa fa-shopping-bag mr-2" aria-hidden="true"></i>Send Orderx</span>
      
  </div>
</div>
                              </form>
      </div>
      </section>
</div>
    
